;
; adaptoid.inf - install wishk300.sys as a HID minidriver for the Adaptoid.
;
; THE DEVICE IS CLAIMED AS HIDClass, NOT AS A RAW USB DEVICE. That is the
; whole arrangement: hidclass.sys owns the device object and this driver
; sits under it as a minidriver, which is what lets one USB endpoint appear
; as a keyboard, a mouse and a game controller at once. Installing it as
; anything else loses the property the driver exists for.
;
; A DELIBERATE DIVERGENCE FROM wishna1.inf, WHICH DECLARES ITS OWN CLASS.
; The original creates a custom setup class, GCAClass
; {93B41274-8DDB-11D5-A5E3-00A0C99B19DF}, "Game controller adapters", from
; a [ClassInstall32] section. That buys nothing functional - hidclass still
; owns the device either way - and it is exactly what makes the original
; fail to install on Windows 7: staging a package does not register a
; class, so the device silently falls through to Microsoft's HidUsb and
; the driver never loads. See docs/configurator-architecture.txt 7.4.
;
; Using the standard HIDClass removes that failure mode entirely, at the
; cost of the device appearing under Human Interface Devices rather than
; in a category of its own.
;
; The hardware ID is the adapter's own: vendor 0x06F7, product 0x0001,
; confirmed against live hardware and against wishna1.inf.
;
; THE ORIGINAL'S SERVICE IS NAMED wishna1k, not after its binary. This one
; is named after its binary on purpose; nothing depends on the old name.
;
; UNSIGNED. 64-bit Windows will not load this without test signing enabled:
;
;     bcdedit /set testsigning on        (then reboot)
;
; and the driver must carry a test certificate. See README.txt section 7.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = HIDClass
ClassGuid   = {745A17A0-74D3-11D0-B6FE-00A0C90F57DA}
Provider    = %ProviderName%
DriverVer   = 09/17/2026,3.0.0917.0641
CatalogFile = adaptoid.cat
PnpLockdown = 1

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
wishk300.sys = 1,,

[DestinationDirs]
DefaultDestDir = 12          ; %windir%\system32\drivers

[Manufacturer]
%ProviderName% = Adaptoid, NTamd64, NTx86

; ---------------------------------------------------------------------
; The device. USB\VID_06F7&PID_0001 is the Adaptoid.
; ---------------------------------------------------------------------

[Adaptoid.NTamd64]
%DeviceName% = Adaptoid_Install, USB\VID_06F7&PID_0001

[Adaptoid.NTx86]
%DeviceName% = Adaptoid_Install, USB\VID_06F7&PID_0001

[Adaptoid_Install.NT]
CopyFiles = Adaptoid_CopyFiles
; HIDCLASS.CopyFiles brings in hidclass.sys and hidparse.sys, which this
; driver registers with and cannot work without.
Include   = input.inf
Needs     = HIDCLASS.CopyFiles

[Adaptoid_CopyFiles]
wishk300.sys

[Adaptoid_Install.NT.Services]
AddService = wishk300, 0x00000002, Adaptoid_Service
Include    = input.inf
Needs      = HIDCLASS.Services

[Adaptoid_Service]
DisplayName   = %ServiceName%
ServiceType   = 1                    ; SERVICE_KERNEL_DRIVER
StartType     = 3                    ; SERVICE_DEMAND_START
ErrorControl  = 1                    ; SERVICE_ERROR_NORMAL
ServiceBinary = %12%\wishk300.sys
LoadOrderGroup = Base

; ---------------------------------------------------------------------
; The one setting the driver reads.
;
; VirtualDevices selects which HID collections the device presents, and the
; driver reads it ONCE PER ARRIVAL - changing it needs a replug, not just a
; restart of the service. The low three bits index an eight-entry table of
; which only two entries differ from the first:
;
;     0..5   joystick only
;     6      mouse + keyboard
;     7      all three          (the default)
;
; NOTE THE PATH. The driver does not read its own service key; it reads a
; fixed absolute path, which is the original's behaviour and is why this
; section writes there rather than under Parameters.
; ---------------------------------------------------------------------

[Adaptoid_Install.NT.HW]
AddReg = Adaptoid_Settings, Adaptoid_Joystick

; ---------------------------------------------------------------------
; The DirectInput presentation, from wishna1.inf's Joy.AddReg.
;
; WITHOUT THIS THE BUTTONS ARE NUMBERED, NOT NAMED. DirectInput and the
; Game Controllers control panel read per-device names from here; with the
; key absent an application shows "Button 1" where it could show "A".
;
; The names and their order are the original's, and they are the third
; independent confirmation of the button map - see
; ../docs/ioctl-surface.txt section 7. They are DESTINATION numbers, so
; they follow drv_ButtonMap rather than the N64 bit order.
;
; THE FORCE-FEEDBACK BLOCK IS DELIBERATELY OMITTED. wishna1.inf also
; registers OEMForceFeedback with CLSID
; {C9BB1D41-B9A2-11D3-8527-00A0C99B19DF} and twelve effect GUIDs. That
; CLSID names Wish's own COM object, which this replacement does not ship;
; registering it would have DirectInput try to create something that is
; not there. The rumble motor is driven through the private IOCTL surface
; instead.
; ---------------------------------------------------------------------

[Adaptoid_Joystick]
HKLM,%OEMKEY%\%VIDPID%,OEMName,,%DeviceName%

HKLM,%OEMKEY%\%VIDPID%\Axes\0,,,"X axis"
HKLM,%OEMKEY%\%VIDPID%\Axes\1,,,"Y axis"
HKLM,%OEMKEY%\%VIDPID%\Axes\0,Attributes,1,01,01,00,00,01,00,30,00
HKLM,%OEMKEY%\%VIDPID%\Axes\1,Attributes,1,01,01,00,00,01,00,31,00

HKLM,%OEMKEY%\%VIDPID%\Buttons\0,,,"A"
HKLM,%OEMKEY%\%VIDPID%\Buttons\1,,,"C-Down"
HKLM,%OEMKEY%\%VIDPID%\Buttons\2,,,"C-Right"
HKLM,%OEMKEY%\%VIDPID%\Buttons\3,,,"B"
HKLM,%OEMKEY%\%VIDPID%\Buttons\4,,,"C-Left"
HKLM,%OEMKEY%\%VIDPID%\Buttons\5,,,"C-Up"
HKLM,%OEMKEY%\%VIDPID%\Buttons\6,,,"L"
HKLM,%OEMKEY%\%VIDPID%\Buttons\7,,,"R"
HKLM,%OEMKEY%\%VIDPID%\Buttons\8,,,"Start"
HKLM,%OEMKEY%\%VIDPID%\Buttons\9,,,"Z"
HKLM,%OEMKEY%\%VIDPID%\Buttons\10,,,"D-Up"
HKLM,%OEMKEY%\%VIDPID%\Buttons\11,,,"D-Down"
HKLM,%OEMKEY%\%VIDPID%\Buttons\12,,,"D-Left"
HKLM,%OEMKEY%\%VIDPID%\Buttons\13,,,"D-Right"

[Adaptoid_Settings]
HKLM,"Software\Wish Technologies\Adaptoid","VirtualDevices",0x00010001,7

[Strings]
ProviderName = "Adaptoid clean-room replacement"
VIDPID       = "VID_06F7&PID_0001"
OEMKEY       = "System\CurrentControlSet\Control\MediaProperties\PrivateProperties\Joystick\OEM"
DiskName     = "Adaptoid Driver Disk"
DeviceName   = "Adaptoid N64 Controller Adapter"
ServiceName  = "Adaptoid HID minidriver"
