// Adaptoid Script

// driver_version = 2.0.0

// ARITHMETIC GROUND TRUTH - one answer per button, Notepad focused.
//
// DECIMAL ONLY. Hexadecimal literals compile to a pointer rather than a
// value in this toolchain - see known-defects.txt Defect 21 - so nothing
// here uses 0x. That is the whole reason this suite was rewritten.
//
// The point is not to find bugs. It is to record what the ORIGINAL
// driver does for the cases where two integer implementations can
// legitimately disagree, so the replacement can be held to the same
// answers instead of to a guess.
//
//   A   dv=  -9 / 2        C truncation gives -4, flooring gives -5
//   B   md=  -9 % 2        sign follows the dividend: -1
//   Z   sr=  -16 >> 2      arithmetic -4, logical 1073741820
//   L   sl=  1 << 32       masked to 5 bits gives 1, unmasked 0
//   R   pr=  2 + 3 * 4     precedence: 14, not 20
//   S   tn=  (5>3)?111:222 the conditional operator: 111
//
// Each line is a handful of keystrokes, well inside the 100-entry
// script event queue that silently drops the OLDEST on overflow.

tap_digit(v)
{
    if (v == 0) { _key('0',1); _key('0',0); }
    if (v == 1) { _key('1',1); _key('1',0); }
    if (v == 2) { _key('2',1); _key('2',0); }
    if (v == 3) { _key('3',1); _key('3',0); }
    if (v == 4) { _key('4',1); _key('4',0); }
    if (v == 5) { _key('5',1); _key('5',0); }
    if (v == 6) { _key('6',1); _key('6',0); }
    if (v == 7) { _key('7',1); _key('7',0); }
    if (v == 8) { _key('8',1); _key('8',0); }
    if (v == 9) { _key('9',1); _key('9',0); }
    return 0;
}

tap_num(n)
{
    int d = 1;

    if (n < 0) {
        _key('minus',1); _key('minus',0);
        n = -n;
    }
    while (d <= n / 10) d = d * 10;
    while (d > 0) {
        tap_digit((n / d) % 10);
        d = d / 10;
    }
    return 0;
}

say(a, b, v)
{
    _key(a,1); _key(a,0);
    _key(b,1); _key(b,0);
    _key('equals',1); _key('equals',0);
    tap_num(v);
    _key('enter',1); _key('enter',0);
    return 0;
}

act_div(p)
{
    int a = -9;
    int b = 2;

    // Through variables, so the compiler cannot fold it away and the
    // answer is the INTERPRETER's, not the compiler's.
    if (p) say('d','v', a / b);
    return 0;
}

act_mod(p)
{
    int a = -9;
    int b = 2;

    if (p) say('m','d', a % b);
    return 0;
}

act_shr(p)
{
    int a = -16;
    int b = 2;

    if (p) say('s','r', a >> b);
    return 0;
}

act_shl(p)
{
    int a = 1;
    int b = 32;

    if (p) say('s','l', a << b);
    return 0;
}

act_prec(p)
{
    if (p) say('p','r', 2 + 3 * 4);
    return 0;
}

act_tern(p)
{
    int a = 5;
    int b = 3;

    if (p) say('t','n', (a > b) ? 111 : 222);
    return 0;
}

main() {}
int on_a(p) = act_div;
int on_b(p) = act_mod;
int on_z(p) = act_shr;
int on_l(p) = act_shl;
int on_r(p) = act_prec;
int on_s(p) = act_tern;
